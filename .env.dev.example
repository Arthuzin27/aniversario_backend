# =====================================================================
# DESENVOLVIMENTO LOCAL. Copie este arquivo para ".env" (nesta mesma pasta) e preencha os valores.
# Produção (VPS): use o .env.example.
# NUNCA versione o arquivo .env com valores reais.
# =====================================================================

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=convite
POSTGRES_USER=convite
# Use uma senha longa e aleatória
POSTGRES_PASSWORD=troque-esta-senha
# Porta local do banco (somente desenvolvimento; ligada apenas a 127.0.0.1)
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
# Segredo de assinatura dos tokens do painel (mínimo 32 caracteres).
# Gere um valor aleatório, por exemplo no PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
# Validade do login administrativo (ex.: 8h, 30m)
JWT_EXPIRACAO=8h

# Primeiro administrador (criado na inicialização se ainda não existir).
# Senha com no mínimo 10 caracteres. ADMIN_RESET_PASSWORD=true redefine a senha
# do usuário existente na próxima inicialização (volte para false depois).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# Endereços do frontend autorizados a chamar a API (separados por vírgula, sem barra no final)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limite de participantes por família
MAX_PARTICIPANTES=30

# Limites de requisições por IP por minuto
RATE_LIMIT_CADASTROS=10
RATE_LIMIT_LOGINS=5

# Swagger UI (/swagger-ui.html). Recomenda-se false em produção.
SWAGGER_ENABLED=true

# Fuso horário usado na data de geração dos relatórios
RELATORIO_FUSO_HORARIO=America/Sao_Paulo

