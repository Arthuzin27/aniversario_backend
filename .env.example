# =====================================================================
# PRODUÇÃO (VPS) — usado pelo docker-compose.prod.yml.
#   cp .env.example .env && chmod 600 .env
# Preencha todos os valores. NUNCA versione o arquivo .env.
# Gere senhas/segredos fortes com:  openssl rand -base64 48
# (Desenvolvimento local: veja .env.dev.example)
# =====================================================================

# --- PostgreSQL ---------------------------------------------------------
# Nome do banco e usuário (ex.: convite). Usados pelo container do Postgres e pelo backend.
DB_NAME=
DB_USERNAME=
# Senha do banco. Gere com: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

# --- Segurança da API -----------------------------------------------------
# Segredo de assinatura dos tokens JWT do painel (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
JWT_SECRET=
# Validade do login administrativo (ex.: 8h, 30m)
JWT_EXPIRACAO=8h

# Primeiro administrador: criado na inicialização somente se ainda não existir.
# Senha com no mínimo 10 caracteres. Depois do primeiro start você pode apagar ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# true = redefine a senha do ADMIN_USERNAME existente para ADMIN_PASSWORD no próximo start (volte para false depois)
ADMIN_RESET_PASSWORD=false

# Origens autorizadas a chamar a API (separadas por vírgula, sem barra no final).
# Front e API ficam na mesma origem, então basta o próprio endereço do site.
CORS_ALLOWED_ORIGINS=https://brenonun3s.vps-kinghost.net:3041

# Limites por IP por minuto (rate limit do formulário público e do login)
RATE_LIMIT_CADASTROS=10
RATE_LIMIT_LOGINS=5

# --- Regras da aplicação --------------------------------------------------
# Máximo de participantes por família no formulário
MAX_PARTICIPANTES=30
# Fuso horário usado na data de geração dos relatórios
RELATORIO_FUSO_HORARIO=America/Sao_Paulo
# Swagger UI. Mantenha false em produção (o Nginx também não o expõe).
SWAGGER_ENABLED=false

# --- Dados da festa exibidos no convite (frontend) ------------------------
# Embutidos no build do frontend: após alterar, rode o "up -d --build" de novo.
# Deixe em branco para ocultar um item.
VITE_FESTA_ANIVERSARIANTE=
# Data no formato AAAA-MM-DD (ex.: 2026-12-12)
VITE_FESTA_DATA=
# Ex.: 20h
VITE_FESTA_HORARIO=
VITE_FESTA_LOCAL=
VITE_FESTA_ENDERECO=
# Link do Google Maps (opcional)
VITE_FESTA_MAPA_URL=
VITE_FESTA_TRAJE=
# Prazo para confirmar presença, AAAA-MM-DD
VITE_FESTA_PRAZO_CONFIRMACAO=
VITE_FESTA_MENSAGEM=
